# Copy to .env and fill in. Every key is optional — with none set, the related
# feature reports "not configured" and the rest of the app works normally.
# docker compose reads .env automatically; for a local (non-Docker) backend,
# set these in your shell instead.

# TopDeck.gg community-deck provider
RIFTBOUND_TOPDECK_KEY=

# Market pricing API
RIFTBOUND_PRICE_API_KEY=

# Optional: fixed JWT signing key (otherwise generated into backend/data/secret.key)
# RIFTBOUND_JWT_SECRET=
